# theme = dark:mytheme-dark,light:mytheme-light
theme = mytheme-dark

# font-family = "JetBrainsMono NF"
# font-family = "MartianMono NF"
# font-family = "IosevkaTerm Nerd Font"
font-family = "BlexMono Nerd Font"

font-size = 16

adjust-cell-height = 23%

# turn off ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

title = " "
window-width = 90
window-height = 30

confirm-close-surface = false
mouse-hide-while-typing = true

config-file = ?darwin
config-file = ?nixos
